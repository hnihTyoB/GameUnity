  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a5e9aa20725140ce8321e7b2fe3d411f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPagination
  tutorialText: {fileID: 767114621}
  previousButton: {fileID: 114837816}
  nextButton: {fileID: 1365234325}
  pageIndicatorText: {fileID: 708673439}
  tutorialPages:
  - "Ch\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi Light of Kindness!\r\n\r\nM\u1EE4C
    TI\xCAU GAME:\r\n\u2022 Gi\u1EA3i c\u1EE9u c\xE1c n\u1EA1n nh\xE2n b\u1ECB b\u1EAFt
    gi\u1EEF\r\n\u2022 Ti\xEAu di\u1EC7t qu\xE1i v\u1EADt v\xE0 s\u1ED1ng s\xF3t\r\n\u2022
    Thu th\u1EADp v\xE0ng v\xE0 v\u1EADt ph\u1EA9m\r\n\u2022 Kh\xE1m ph\xE1 c\xE1c
    khu v\u1EF1c b\xED \u1EA9n\r\n\r\nS\u1EE9 m\u1EC7nh c\u1EE7a b\u1EA1n l\xE0 mang
    \xE1nh s\xE1ng c\u1EE7a \r\nl\xF2ng nh\xE2n \xE1i \u0111\u1EBFn nh\u1EEFng n\u01A1i
    t\u0103m t\u1ED1i nh\u1EA5t.\r\n\r\nH\xE3y d\u0169ng c\u1EA3m v\xE0 kh\xF4n ngoan!"
  - "\u0110I\u1EC0U KHI\u1EC2N NH\xC2N V\u1EACT:\r\n\r\nDI CHUY\u1EC2N:\r\n\u2022
    WASD ho\u1EB7c Ph\xEDm m\u0169i t\xEAn\r\n  - W/\u2191: Di chuy\u1EC3n l\xEAn\r\n 
    - S/\u2193: Di chuy\u1EC3n xu\u1ED1ng\r\n  - A/\u2190: Di chuy\u1EC3n tr\xE1i\r\n 
    - D/\u2192: Di chuy\u1EC3n ph\u1EA3i\r\n\r\nH\xC0NH \u0110\u1ED8NG:\r\n\u2022
    Chu\u1ED9t tr\xE1i: T\u1EA5n c\xF4ng\r\n\u2022 Chu\u1ED9t ph\u1EA3i: Nh\u1EAFm
    m\u1EE5c ti\xEAu\r\n\u2022 Space: L\u01B0\u1EDBt (Dash)\r\n\r\nL\u01B0\u1EDBt
    n\xE9 ti\xEAu t\u1ED1n Stamina!"
  - "1 \u0110\xC8N PIN (FLASHLIGHT)\r\n\u2022 Chi\u1EBFu s\xE1ng khu v\u1EF1c t\u1ED1i\r\n\u2022
    Ti\xEAu t\u1ED1n n\u0103ng l\u01B0\u1EE3ng pin\r\n\u2022 C\u1EA7n thi\u1EBFt
    \u0111\u1EC3 kh\xE1m ph\xE1\r\n\r\n2 KHI\xCAN (SHIELD)  \r\n\u2022 K\xEDch ho\u1EA1t
    \u0111\u1EC3 ph\xF2ng th\u1EE7\r\n\u2022 Ch\u1EB7n \u0111\xF2n t\u1EA5n c\xF4ng
    \u0111\u1ECBch\r\n\u2022 Ti\xEAu t\u1ED1n Stamina khi active\r\n\r\n3 V\u0168
    KH\xCD T\u1EA4N C\xD4NG\r\n\u2022 Th\xE1nh gi\xE1: T\u1EA5n c\xF4ng c\u1EADn
    chi\u1EBFn\r\n\u2022 Cung: B\u1EAFn t\u1EA7m xa\r\n\u2022 G\u1EADy ma thu\u1EADt:
    N\u0103ng l\u01B0\u1EE3ng"
  - "CH\u1EC8 S\u1ED0 QUAN TR\u1ECCNG:\r\n\r\n\u2764\uFE0F M\xC1U (HEALTH)\r\n\u2022
    Sinh l\u1EF1c c\u1EE7a b\u1EA1n\r\n\u2022 Khi h\u1EBFt m\xE1u = Game Over\r\n\u2022
    H\u1ED3i m\xE1u b\u1EB1ng tr\xE1i tim\r\n\r\n\u26A1 STAMINA (N\u0102NG L\u01AF\u1EE2NG)\r\n\u2022
    D\xF9ng cho l\u0103n n\xE9 v\xE0 khi\xEAn\r\n\u2022 T\u1EF1 \u0111\u1ED9ng h\u1ED3i
    theo th\u1EDDi gian\r\n\u2022 Qu\u1EA3n l\xFD c\u1EA9n th\u1EADn!\r\n\r\n\U0001F50B
    PIN (BATTERY)\r\n\u2022 N\u0103ng l\u01B0\u1EE3ng cho \u0111\xE8n pin\r\n\u2022
    T\xECm pin \u0111\u1EC3 n\u1EA1p th\xEAm\r\n\u2022 T\u1EAFt \u0111\xE8n khi kh\xF4ng
    c\u1EA7n"
  - "V\u1EACT PH\u1EA8M TRONG GAME:\r\n\r\n\u2764\uFE0F TR\xC1I TIM\r\n\u2022 H\u1ED3i
    m\xE1u cho nh\xE2n v\u1EADt\r\n\u2022 Xu\u1EA5t hi\u1EC7n khi ph\xE1 v\u1EADt
    th\u1EC3\r\n\r\n\U0001F5E1\uFE0F V\u0168 KH\xCD\r\n\u2022 T\xECm v\u0169 kh\xED
    m\u1EDBi\r\n\u2022 M\u1ED7i lo\u1EA1i c\xF3 \u01B0u \u0111i\u1EC3m ri\xEAng\r\n\r\n\U0001F50B
    PIN\r\n\u2022 N\u1EA1p n\u0103ng l\u01B0\u1EE3ng \u0111\xE8n pin\r\n\u2022 Quan
    tr\u1ECDng trong b\xF3ng t\u1ED1i\r\n\r\n\U0001F3AF N\u1EA0N NH\xC2N\r\n\u2022
    Gi\u1EA3i c\u1EE9u \u0111\u1EC3 ho\xE0n th\xE0nh m\xE0n\r\n\u2022 \u0110\u01B0\u1EE3c
    \u0111\xE1nh d\u1EA5u b\u1EB1ng icon"
  - "CHI\u1EBEN THU\u1EACT SINH T\u1ED2N:\r\n\r\n\u2713 CHI\u1EBEU S\xC1NG\r\nLu\xF4n
    d\xF9ng \u0111\xE8n pin trong khu v\u1EF1c \r\nt\u1ED1i \u0111\u1EC3 ph\xE1t
    hi\u1EC7n nguy hi\u1EC3m\r\n\r\n\u2713 PH\xD2NG TH\u1EE6\r\nK\xEDch ho\u1EA1t
    khi\xEAn khi \u0111\u1ED1i m\u1EB7t \r\nnhi\u1EC1u k\u1EBB \u0111\u1ECBch c\xF9ng
    l\xFAc\r\n\r\n\u2713 QU\u1EA2N L\xDD STAMINA\r\nKh\xF4ng l\u0103n n\xE9 li\xEAn
    t\u1EE5c, gi\u1EEF \r\nstamina cho l\xFAc kh\u1EA9n c\u1EA5p\r\n\r\n\u2713 KH\xC1M
    PH\xC1\r\nPh\xE1 c\xE1c h\xF2m, b\u1EE5i c\xE2y \u0111\u1EC3 t\xECm \r\nv\u1EADt
    ph\u1EA9m h\u1EEFu \xEDch\r\n\r\n\u2713 AN TO\xC0N\r\nGi\u1EA3i c\u1EE9u n\u1EA1n
    nh\xE2n l\xE0 \u01B0u ti\xEAn \r\n\u0111\u1EC3 ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5\r\n\r\nCh\xFAc
    b\u1EA1n may m\u1EAFn v\xE0 chi\u1EBFn th\u1EAFng!"
