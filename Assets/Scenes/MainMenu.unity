  m_Script: {fileID: 11500000, guid: a5e9aa20725140ce8321e7b2fe3d411f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPagination
  tutorialText: {fileID: 767114621}
  previousButton: {fileID: 114837816}
  nextButton: {fileID: 1365234325}
  pageIndicatorText: {fileID: 708673439}
  tutorialPages:
  - "Ch\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi Light of Kindness!\r\n\r\nM\u1EE4C
    TI\xCAU GAME:\r\n\u2022 Gi\u1EA3i c\u1EE9u c\xE1c n\u1EA1n nh\xE2n b\u1ECB l\u1EA1c\r\n\u2022
    N\xE9 tr\xE1nh c\xE1c b\xF3ng ma v\xE0 qu\xE1i v\u1EADt\r\n\u2022 Thu th\u1EADp
    pin v\xE0 n\u0103ng l\u01B0\u1EE3ng\r\n\r\nS\u1EE9 m\u1EC7nh c\u1EE7a b\u1EA1n
    l\xE0 mang \xE1nh s\xE1ng c\u1EE7a \r\nl\xF2ng nh\xE2n \xE1i \u0111\u1EBFn nh\u1EEFng
    n\u01A1i t\u0103m t\u1ED1i nh\u1EA5t.\r\n\r\nH\xE3y d\u0169ng c\u1EA3m v\xE0
    kh\xF4n ngoan!"
  - "\u0110I\u1EC0U KHI\u1EC2N NH\xC2N V\u1EACT:\r\n\r\nDI CHUY\u1EC2N:\r\n\u2022
    WASD ho\u1EB7c Ph\xEDm m\u0169i t\xEAn\r\n  - W: Di chuy\u1EC3n l\xEAn\r\n  -
    S: Di chuy\u1EC3n xu\u1ED1ng\r\n  - A: Di chuy\u1EC3n tr\xE1i\r\n  - D: Di chuy\u1EC3n
    ph\u1EA3i\r\nH\xC0NH \u0110\u1ED8NG:\r\n\u2022 Chu\u1ED9t tr\xE1i: T\u1EA5n c\xF4ng\r\n\u2022
    Space: L\u01B0\u1EDBt (Ti\xEAu t\u1ED1n n\u0103ng l\u01B0\u1EE3ng)\n\u2022 E:
    D\u1EABn n\u1EA1n nh\xE2n \u0111i theo"
  - "TRANG B\u1ECA NH\xC2N V\u1EACT\n\n1 \u0110\xC8N PIN\r\n\u2022 Chi\u1EBFu s\xE1ng
    khu v\u1EF1c t\u1ED1i\n\u2022 Ng\u0103n c\u1EA3n b\xF3ng ma\r\n\u2022 Ti\xEAu
    t\u1ED1n n\u0103ng l\u01B0\u1EE3ng pin\r\n2 KHI\xCAN  \r\n\u2022 K\xEDch ho\u1EA1t
    \u0111\u1EC3 ph\xF2ng th\u1EE7\r\n\u2022 Ch\u1EB7n s\u1EF1 ti\u1EBFp c\u1EADn
    c\u1EE7a b\xF3ng ma\r\n3 TH\xC1NH GI\xC1\r\n\u2022 T\u1EA5n c\xF4ng c\u1EADn
    chi\u1EBFn\r\n\u2022 Ph\xE1 h\u1EE7y v\u1EADt th\u1EC3 v\xE0 ph\xF2ng v\u1EC7"
  - "CH\u1EC8 S\u1ED0 QUAN TR\u1ECCNG:\n\n1 PIN\n\u2022 N\u0103ng l\u01B0\u1EE3ng
    cho \u0111\xE8n pin\n\u2022 T\xECm pin \u0111\u1EC3 n\u1EA1p th\xEAm\n\u2022
    T\u1EAFt \u0111\xE8n khi kh\xF4ng c\u1EA7n\r\n2 N\u0102NG L\u01AF\u1EE2NG\r\n\u2022
    D\xF9ng cho l\u01B0\u1EDBt\r\n\u2022 T\u1EF1 \u0111\u1ED9ng h\u1ED3i theo th\u1EDDi
    gian\r\n\u2022 Qu\u1EA3n l\xFD c\u1EA9n th\u1EADn!\n3 N\u1EA0N NH\xC2N\n\u2022
    Hi\u1EC7n s\u1ED1 l\u01B0\u1EE3ng n\u1EA1n nh\xE2n \u0111\xE3 c\u1EE9u\n\u2022
    C\u1EE9u nhi\u1EC1u nh\u1EA5t c\xF3 th\u1EC3"
  - "CHI\u1EBEN THU\u1EACT SINH T\u1ED2N:\r\n\r\nCHI\u1EBEU S\xC1NG\r\nLu\xF4n d\xF9ng
    \u0111\xE8n pin trong khu v\u1EF1c t\u1ED1i \u0111\u1EC3 ph\xE1t hi\u1EC7n nguy
    hi\u1EC3m\r\nPH\xD2NG TH\u1EE6\r\nK\xEDch ho\u1EA1t khi\xEAn khi \u0111\u1ED1i
    m\u1EB7t nhi\u1EC1u k\u1EBB \u0111\u1ECBch c\xF9ng l\xFAc\r\nQU\u1EA2N L\xDD
    N\u0102NG L\u01AF\u1EE2NG\r\nKh\xF4ng l\u01B0\u1EDBt li\xEAn t\u1EE5c, gi\u1EEF
    n\u0103ng l\u01B0\u1EE3ng cho l\xFAc kh\u1EA9n c\u1EA5p\nKH\xC1M PH\xC1\r\nPh\xE1
    c\xE1c h\xF2m, b\u1EE5i c\xE2y \u0111\u1EC3 t\xECm v\u1EADt ph\u1EA9m h\u1EEFu
    \xEDch\r\nAN TO\xC0N\r\nGi\u1EA3i c\u1EE9u n\u1EA1n nh\xE2n l\xE0 \u01B0u ti\xEAn
    \u0111\u1EC3 ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5\r\n\r\nCh\xFAc b\u1EA1n may
    m\u1EAFn v\xE0 chi\u1EBFn th\u1EAFng!"
